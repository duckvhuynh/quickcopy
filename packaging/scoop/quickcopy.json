{
    "version": "0.1.0",
    "description": "Select and copy text in any on-screen image",
    "homepage": "https://github.com/duckvhuynh/quickcopy",
    "license": "MIT|Apache-2.0",
    "notes": "Vietnamese reading needs the VieSVTR model, downloaded separately into $dir\\models\\viesvtr (see the README).",
    "architecture": {
        "64bit": {
            "url": "https://github.com/duckvhuynh/quickcopy/releases/download/v0.1.0/QuickCopy-0.1.0-windows-x64.zip",
            "hash": "REPLACE_WITH_ZIP_SHA256_FROM_SHA256SUMS"
        }
    },
    "extract_dir": "QuickCopy",
    "bin": "quickcopy.exe",
    "shortcuts": [
        [
            "quickcopy.exe",
            "QuickCopy"
        ]
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/duckvhuynh/quickcopy/releases/download/v$version/QuickCopy-$version-windows-x64.zip"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS.txt"
        }
    }
}
